; Lab 4, adjacent tables: two dense case statements; the first one's table is followed in memory by the
; second one's. The selector 5 is one past the first statement's largest key.
(program
  (vars k)
  (body
    (set! k 5)
    (case k (1 (print 11)) (2 (print 12)) (3 (print 13)) (4 (print 14)) (else (print 10)))
    (print 99)
    (case k (1 (print 21)) (2 (print 22)) (3 (print 23)) (4 (print 24)) (else (print 20)))
    (print 999)))
