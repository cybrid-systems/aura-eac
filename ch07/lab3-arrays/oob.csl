; Lab 3, out of range: A[2,5] does not exist (the second dimension is 1..4).
(program
  (vars i j)
  (arrays (A (1 3) (1 4)))
  (body
    (set! i 1)
    (while (<= i 3)
      (set! j 1)
      (while (<= j 4) (aset! A i j (+ (* 10 i) j)) (set! j (+ j 1)))
      (set! i (+ i 1)))
    (print (aref A 2 5))))
