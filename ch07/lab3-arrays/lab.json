{
  "title": "数组寻址 / Array addressing",
  "sections": [
    "7.5.1",
    "7.5.2",
    "7.5.3"
  ],
  "program": "program.csl",
  "programs": {
    "oob": {
      "file": "oob.csl"
    }
  },
  "addr": [
    "A 2 3",
    "A 1 1",
    "A 3 4"
  ],
  "checks": [
    {
      "name": "row-major: A[2,3] at base + ((2-1)*4 + (3-1))*4",
      "expect_output": [
        23,
        14,
        31,
        7,
        8
      ],
      "expect_matches_reference": true,
      "expect_address": {
        "A 1 1": 288,
        "A 2 3": 312,
        "A 3 4": 332
      }
    },
    {
      "name": "column-major: same output, A[2,3] at base + ((3-1)*3 + (2-1))*4",
      "mutations": [
        "column-major"
      ],
      "expect_output": [
        23,
        14,
        31,
        7,
        8
      ],
      "expect_matches_reference": true,
      "expect_address": {
        "A 1 1": 288,
        "A 2 3": 316
      }
    },
    {
      "name": "indirection vectors: same output, 102 loads instead of 87",
      "mutations": [
        "indirection"
      ],
      "expect_matches_reference": true,
      "expect_stats": {
        "loads": 102
      },
      "expect_address": {
        "A 2 3": 324
      }
    },
    {
      "name": "dope vector at run time: same output, 204 loads",
      "mutations": [
        "dope-vector"
      ],
      "expect_matches_reference": true,
      "expect_stats": {
        "loads": 204
      },
      "expect_address": {
        "A 2 3": 312
      }
    },
    {
      "name": "out-of-range subscript traps with range checks",
      "program": "oob",
      "expect_error": "out of bounds",
      "expect_matches_reference": true
    },
    {
      "name": "no range checks: A[2,5] silently reads A[3,1] = 31",
      "program": "oob",
      "mutations": [
        "no-bounds-check"
      ],
      "expect_output": [
        31
      ],
      "expect_matches_reference": false
    },
    {
      "name": "no range checks on a correct program: same output, 382 instead of 586 instructions executed",
      "mutations": [
        "no-bounds-check"
      ],
      "expect_matches_reference": true,
      "expect_stats": {
        "ops": 382
      }
    },
    {
      "name": "lower bound forgotten: A[3,4] lands on B[0]",
      "mutations": [
        "forget-lower-bound"
      ],
      "expect_output": [
        23,
        14,
        31,
        34,
        8
      ],
      "expect_matches_reference": false,
      "expect_address": {
        "A 1 1": 308,
        "A 3 4": 352
      }
    },
    {
      "name": "extent hi-lo: A[1,4] and A[2,1] share an address",
      "mutations": [
        "extent-off-by-one"
      ],
      "expect_output": [
        23,
        21,
        31,
        7,
        8
      ],
      "expect_matches_reference": false,
      "expect_address": {
        "A 1 4": 300,
        "A 2 1": 300
      }
    }
  ],
  "mutations": {
    "column-major": {
      "define": "array-layout",
      "body": "(lambda (name) \"column\")",
      "reason": "column-major storage",
      "explain": "列主序：同一列的元素相邻。程序输出不变，但 A[2,3] 的地址变了，地址公式里乘的是第一维的长度。"
    },
    "indirection": {
      "define": "array-layout",
      "body": "(lambda (name) \"indirect\")",
      "reason": "indirection vectors (row pointers)",
      "explain": "间接向量：先按第一个下标取出行指针，再加上列偏移。不再需要乘行长，代价是每次访问多一次 load（这里每次访问的乘法次数不变，因为两种布局都要把下标乘以元素宽度 4）。"
    },
    "dope-vector": {
      "define": "dope-vector?",
      "body": "(lambda (name) #t)",
      "reason": "read bounds and extents from the dope vector at run time",
      "explain": "形状在编译时未知（比如数组作为参数传进来）时，下界、上界和长度都要从 dope vector 里读，每次访问多出几次 load。"
    },
    "no-bounds-check": {
      "define": "bounds-check?",
      "body": "(lambda (name) #f)",
      "program": "oob",
      "reason": "drop the subscript range checks",
      "explain": "不检查下标：A[2,5] 按行主序算出来正好是 A[3,1] 的地址，静默读到 31。语言规定这里应该报越界。"
    },
    "forget-lower-bound": {
      "define": "index-origin",
      "body": "(lambda (lo) 0)",
      "reason": "wrong: treat every dimension as if it started at 0",
      "explain": "忘了减下界：A 的两维都从 1 开始，每个地址都偏后一行加一个元素，最后几次写入越过了 A 的末尾，写进了 B。"
    },
    "extent-off-by-one": {
      "define": "extent",
      "body": "(lambda (lo hi) (- hi lo))",
      "reason": "wrong: extent = hi - lo (forgot the +1)",
      "explain": "行长算成 hi - lo = 3：每行比实际短一个元素，A[1,4] 和 A[2,1] 落在同一个地址，后写的覆盖先写的。"
    }
  }
}
