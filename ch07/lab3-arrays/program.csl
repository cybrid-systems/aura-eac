; Lab 3 (ch07): A is declared A[1..3, 1..4]; B[0..3] is allocated right after A.
; A[i,j] = 10*i + j, so every element names its own position.
(program
  (vars i j s)
  (arrays (A (1 3) (1 4)) (B (0 3)))
  (body
    (aset! B 0 7) (aset! B 1 8)
    (set! i 1)
    (while (<= i 3)
      (set! j 1)
      (while (<= j 4) (aset! A i j (+ (* 10 i) j)) (set! j (+ j 1)))
      (set! i (+ i 1)))
    (print (aref A 2 3))
    (print (aref A 1 4))
    (print (aref A 3 1))
    (print (aref B 0))
    (print (aref B 1))))
