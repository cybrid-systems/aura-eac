; Lab 3: the same call sites under different parameter-binding policies.
(program
  (globals a b i)
  (proc main () (locals)
    (set! a 1)
    (set! b 2)
    (call swap a b)
    (print a)
    (print b)
    (set! i 1)
    (call bump i i)
    (print i)
    (print (call sum i 1 5 (* i i))))
  (proc swap (x y) (locals t)
    (set! t x)
    (set! x y)
    (set! y t))
  (proc bump (u v) (locals)
    (set! u (+ u 1))
    (set! v (+ v 10)))
  ; sum k from lo to hi of term: with k and term bound by name this is Jensen's device
  (proc sum (k lo hi term) (locals s)
    (set! s 0)
    (set! k lo)
    (while (<= k hi)
      (set! s (+ s term))
      (set! k (+ k 1)))
    (return s)))
