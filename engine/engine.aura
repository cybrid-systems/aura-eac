;; aura-eac engine: a small Algol-like language ("MAL") run on an explicit activation-record (AR) machine.
;;
;; Everything a compiler's runtime convention decides lives in the Aura WORKSPACE as plain defines
;; (see ch06/policy.aura): how many static-link hops to take when setting up a callee's static link,
;; which chain a non-local access walks, how each parameter is passed, the frame layout, which registers a
;; callee saves, and how a method call is dispatched. This file is the "hardware": memory, frames, the
;; interpreter loop, and a line protocol. The learner (or the host driver) rewrites a policy with
;; mutate:rebind, re-evaluates with eval-current, runs the program again, and undoes with ast:restore.
;;
;; Workspace rules (Aura issues found while writing this):
;;   - policies are pure functions of their arguments; they never read host globals or call host helpers
;;     (cybrid-systems/aura#4587: such names read as 0, and the post-mutate typecheck rejects every rebind)
;;   - no self-recursive defines in the workspace (aura#4583), no filter/map in the workspace (aura#4584)
;;
;; Protocol: one request per stdin line (tab separated), one response per stdout line: "R " + JSON.
;;   POLICY path                 set-code (read-file path) + eval-current + ast:snapshot "base"
;;   LOAD json                   load a MAL program (JSON form of the s-expression, produced by the host)
;;   RUN                         run main -> {output trace snaps stats error frames}
;;   MUTATE name body reason     ast:snapshot, mutate:rebind name body, eval-current -> {ok snap}
;;   ROLLBACK                    ast:restore the newest MUTATE snapshot, eval-current -> {ok depth}
;;   SOURCE                      current-source :workspace
;;   CALL name arg...            call a workspace policy with string/number args (for probing)
;;   PING ; QUIT

;; ---------------------------------------------------------------- program tables
(define *procs* (hash))      ;; proc name -> info hash (name params locals kids body level parent)
(define *classes* (hash))    ;; class name -> info hash (name parent fields methods vtable)
(define *globals* (list))
(define *loaded* #f)

;; ---------------------------------------------------------------- machine state
(define *mem* (hash))        ;; ar id -> vector (the frame's storage)
(define *meta* (hash))       ;; ar id -> hash (proc level layout saved kind)
(define *stack* (list))      ;; live ar ids, newest first
(define *next-ar* 0)
(define *regs* (make-vector 4 0))
(define *out* (list))
(define *trace* (list))
(define *snaps* (list))
(define *stats* (hash))
(define *fuel* 0)
(define *max-fuel* 200000)
(define *max-depth* 200)
(define *callno* 0)

(define (stat-inc! k) (hash-set! *stats* k (+ 1 (hash-ref *stats* k 0))))
(define (stat-max! k v) (if (> v (hash-ref *stats* k 0)) (hash-set! *stats* k v) #f))
(define (tick!)
  (set! *fuel* (+ *fuel* 1))
  (if (> *fuel* *max-fuel*) (error "fuel exhausted (infinite loop or runaway recursion?)") #f))
(define (tagged? v tag) (and (pair? v) (equal? (car v) tag)))
(define (truthy v) (not (equal? v 0)))
(define (b2i b) (if b 1 0))
(define (num s) (number->string s))

;; ---------------------------------------------------------------- loading
(define (proc-section p key)          ;; ("locals" ...) / ("procs" ...) right after the param list
  (let loop ((xs (list-tail p 3)))
    (cond ((null? xs) #f)
          ((and (pair? (car xs)) (equal? (car (car xs)) key)) (cdr (car xs)))
          ((and (pair? (car xs)) (or (equal? (car (car xs)) "locals") (equal? (car (car xs)) "procs"))) (loop (cdr xs)))
          (else #f))))
(define (proc-body p)
  (let loop ((xs (list-tail p 3)))
    (if (and (pair? xs) (pair? (car xs)) (or (equal? (car (car xs)) "locals") (equal? (car (car xs)) "procs")))
        (loop (cdr xs))
        xs)))

(define (load-proc! p parent level)
  (let* ((name (list-ref p 1))
         (kids (or (proc-section p "procs") (list)))
         (info (hash "name" name "params" (list-ref p 2) "locals" (or (proc-section p "locals") (list))
                     "kids" (map (lambda (k) (list-ref k 1)) kids) "body" (proc-body p)
                     "level" level "parent" parent)))
    (if (hash-ref *procs* name #f) (error (string-append "duplicate procedure name: " name)) #f)
    (hash-set! *procs* name info)
    (for-each (lambda (k) (load-proc! k name (+ level 1))) kids)))

;; class: ("class" Name ("extends" P)? ("fields" f...) ("methods" (proc m (self ...) ...) ...))
(define (class-section c key)
  (let loop ((xs (list-tail c 2)))
    (cond ((null? xs) #f)
          ((and (pair? (car xs)) (equal? (car (car xs)) key)) (cdr (car xs)))
          (else (loop (cdr xs))))))
(define (load-class! c)
  (let* ((name (list-ref c 1))
         (ext (class-section c "extends"))
         (parent (if ext (car ext) #f))
         (pinfo (if parent (hash-ref *classes* parent #f) #f))
         (own-fields (or (class-section c "fields") (list)))
         (methods (or (class-section c "methods") (list)))
         ;; object record layout: slot 0 = method-vector pointer (class name), then inherited fields, own fields
         (fields (append (if pinfo (hash-ref pinfo "fields" (list)) (list)) own-fields))
         ;; method vector: inherited slots keep their index; an override replaces the entry in the same slot
         (vt (if pinfo (hash-ref pinfo "vtable" (list)) (list))))
    (if (and parent (not pinfo)) (error (string-append "class " name ": unknown parent " parent)) #f)
    (for-each
      (lambda (m)
        (let* ((mname (list-ref m 1)) (impl (string-append name "." mname)))
          (load-proc! (append (list "proc" impl) (list-tail m 2)) "%program" 1)
          (set! vt (vt-put vt mname impl))))
      methods)
    (hash-set! *classes* name (hash "name" name "parent" parent "fields" fields "vtable" vt))))
(define (vt-put vt mname impl)          ;; vt = list of (method . impl); keep slot order
  (if (assoc mname vt)
      (map (lambda (e) (if (equal? (car e) mname) (cons mname impl) e)) vt)
      (append vt (list (cons mname impl)))))

(define (load-program! prog)
  (set! *procs* (hash)) (set! *classes* (hash)) (set! *globals* (list))
  (for-each
    (lambda (form)
      (cond ((equal? (car form) "globals") (set! *globals* (cdr form)))
            ((equal? (car form) "proc") (load-proc! form "%program" 1))
            ((equal? (car form) "class") (load-class! form))
            (else (error (string-append "unknown top-level form: " (car form))))))
    (cdr prog))
  (if (not (hash-ref *procs* "main" #f)) (error "program has no main") #f)
  (set! *loaded* #t))

;; ---------------------------------------------------------------- lexical structure (from the program text)
(define (pinfo n)
  (let ((i (hash-ref *procs* n #f))) (if i i (error (string-append "no such procedure: " n)))))
(define (plevel p) (if (equal? p "%program") 0 (hash-ref (pinfo p) "level" 0)))
(define (pparent p) (hash-ref (pinfo p) "parent" "%program"))
(define (declares? p x)
  (if (equal? p "%program")
      (if (member x *globals*) #t #f)
      (let ((i (pinfo p))) (if (or (member x (hash-ref i "params" (list))) (member x (hash-ref i "locals" (list)))) #t #f))))
(define (decl-proc p x)               ;; innermost enclosing scope that declares x, or #f
  (cond ((declares? p x) p)
        ((equal? p "%program") #f)
        (else (decl-proc (pparent p) x))))
(define (ancestor-or-self? a p)
  (cond ((equal? a p) #t) ((equal? p "%program") #f) (else (ancestor-or-self? a (pparent p)))))

;; ---------------------------------------------------------------- frames
(define (push-names acc prefix names off)
  (let loop ((ns names) (i off) (acc acc))
    (if (null? ns) acc (loop (cdr ns) (+ i 1) (cons (cons (string-append prefix (car ns)) i) acc)))))
(define (build-layout areas params locals saved)   ;; -> (size . ((field . offset) ...))
  (let loop ((as areas) (off 0) (acc (list)))
    (if (null? as)
        (cons off (reverse acc))
        (let ((a (car as)))
          (cond ((equal? a "params") (loop (cdr as) (+ off (length params)) (push-names acc "p:" params off)))
                ((equal? a "locals") (loop (cdr as) (+ off (length locals)) (push-names acc "l:" locals off)))
                ((equal? a "saved") (loop (cdr as) (+ off (length saved)) (push-names acc "s:" saved off)))
                (else (loop (cdr as) (+ off 1) (cons (cons a off) acc))))))))

(define (new-ar! meta size)
  (let ((id *next-ar*))
    (set! *next-ar* (+ id 1))
    (hash-set! *mem* id (make-vector size 0))
    (hash-set! *meta* id meta)
    id))
(define (alloc-ar! p)
  (let* ((i (pinfo p))
         (saved (callee-saves p))
         (lay (build-layout (frame-areas p) (hash-ref i "params" (list)) (hash-ref i "locals" (list)) saved)))
    (new-ar! (hash "proc" p "level" (plevel p) "layout" (cdr lay) "saved" saved "kind" "frame") (car lay))))
(define (ar-meta a)
  (let ((m (hash-ref *meta* a #f)))
    (if m m (error (string-append "dangling reference: AR #" (num a) " was already destroyed")))))
(define (ar-proc a) (hash-ref (ar-meta a) "proc" "?"))
(define (ar-name a) (string-append "#" (num a) " " (ar-proc a)))
(define (field-off a f) (let ((e (assoc f (hash-ref (ar-meta a) "layout" (list))))) (if e (cdr e) #f)))
(define (fget a f why)
  (let ((o (field-off a f)))
    (if o (vector-ref (hash-ref *mem* a #f) o)
        (error (string-append "linkage: frame " (ar-name a) " has no '" f "' slot (" why ")")))))
(define (fset! a f v why)
  (let ((o (field-off a f)))
    (if o (vector-set! (hash-ref *mem* a #f) o v)
        (error (string-append "linkage: frame " (ar-name a) " has no '" f "' slot (" why ")")))))
(define (fset-if! a f v) (let ((o (field-off a f))) (if o (vector-set! (hash-ref *mem* a #f) o v) #f)))
(define (mem-ref addr) (ar-meta (car addr)) (vector-ref (hash-ref *mem* (car addr) #f) (cadr addr)))
(define (mem-set! addr v) (ar-meta (car addr)) (vector-set! (hash-ref *mem* (car addr) #f) (cadr addr) v))
(define (alloc-temp! v)                ;; a compiler temporary for "reference to an expression"
  (let ((id (new-ar! (hash "proc" "%temp" "level" -1 "layout" (list (cons "t" 0)) "saved" (list) "kind" "temp") 1)))
    (vector-set! (hash-ref *mem* id #f) 0 v)
    id))

(define (follow a hops chain)          ;; walk `hops` links of `chain` ("static" | "dynamic") starting at a
  (let loop ((x a) (h hops))
    (if (<= h 0) x
        (let ((nxt (fget x chain (string-append "following the " chain " link"))))
          (stat-inc! (string-append chain "-follows"))
          (if (equal? nxt -1) (error (string-append "walked off the end of the " chain " chain at " (ar-name x))) #f)
          (loop nxt (- h 1))))))

;; ---------------------------------------------------------------- variables
;; slot contents: a number, ("ref" ar off), ("name" expr env-ar), ("closure" proc env-ar), ("obj" ar class)
(define (var-addr a x)
  (let* ((p (ar-proc a)) (d (decl-proc p x)))
    (cond ((not d) (error (string-append "unbound variable " x " in " p)))
          ((equal? d "%program") (list 0 (field-off 0 (string-append "l:" x))))   ;; globals: fixed address, no link
          (else
           (let* ((hops (access-hops (plevel p) (plevel d)))
                  (chain (access-chain))
                  (target (follow a hops chain)))
             (if (> hops 0) (stat-inc! "nonlocal-accesses") #f)
             (let ((o (or (field-off target (string-append "p:" x)) (field-off target (string-append "l:" x)))))
               (if o (list target o)
                   (error (string-append "non-local access to " x " from " (ar-name a) ": took " (num hops) " "
                                         chain " hop(s) and reached " (ar-name target) ", which has no " x)))))))))
(define (read-var a x)
  (let ((v (mem-ref (var-addr a x))))
    (cond ((tagged? v "ref") (mem-ref (cdr v)))
          ((tagged? v "name") (stat-inc! "thunk-evals") (eval-expr (list-ref v 1) (list-ref v 2)))
          (else v))))
(define (write-var! a x val)
  (let* ((addr (var-addr a x)) (v (mem-ref addr)))
    (cond ((tagged? v "ref") (mem-set! (cdr v) val))
          ((tagged? v "name")
           (if (string? (list-ref v 1)) (write-var! (list-ref v 2) (list-ref v 1) val)
               (error (string-append "call-by-name: cannot assign to the expression bound to " x))))
          (else (mem-set! addr val)))))
(define (addr-of a x)                  ;; address a by-reference actual denotes (follows an existing ref)
  (let* ((addr (var-addr a x)) (v (mem-ref addr)))
    (if (tagged? v "ref") (cdr v) addr)))

;; ---------------------------------------------------------------- expressions / statements
(define (arith op x y)
  (cond ((equal? op "+") (+ x y)) ((equal? op "-") (- x y)) ((equal? op "*") (* x y))
        ((equal? op "/") (if (= y 0) (error "division by zero") (quotient x y)))
        ((equal? op "%") (remainder x y))
        ((equal? op "<") (b2i (< x y))) ((equal? op "<=") (b2i (<= x y)))
        ((equal? op ">") (b2i (> x y))) ((equal? op ">=") (b2i (>= x y)))
        ((equal? op "=") (b2i (equal? x y))) ((equal? op "!=") (b2i (not (equal? x y))))
        ((equal? op "and") (b2i (and (truthy x) (truthy y)))) ((equal? op "or") (b2i (or (truthy x) (truthy y))))
        (else (error (string-append "unknown operator " op)))))
(define (reg-index r)
  (cond ((equal? r "r0") 0) ((equal? r "r1") 1) ((equal? r "r2") 2) ((equal? r "r3") 3)
        (else (error (string-append "unknown register " r)))))

(define (eval-expr e a)
  (tick!)
  (cond ((number? e) e)
        ((string? e) (read-var a e))
        (else
         (let ((op (car e)))
           (cond ((equal? op "call") (do-call e a))
                 ((equal? op "proc-ref") (make-closure (list-ref e 1) a))
                 ((equal? op "reg") (vector-ref *regs* (reg-index (list-ref e 1))))
                 ((equal? op "new") (new-object (list-ref e 1)))
                 ((equal? op "send") (do-send e a #f))
                 ((equal? op "send-as") (do-send (cdr e) a (list-ref e 1)))
                 ((equal? op "field") (obj-field (eval-expr (list-ref e 1) a) (list-ref e 2) #f #f))
                 ((equal? op "%temp-load") (mem-ref (list (list-ref e 1) 0)))
                 ((equal? op "not") (b2i (not (truthy (eval-expr (list-ref e 1) a)))))
                 (else (arith op (eval-expr (list-ref e 1) a) (eval-expr (list-ref e 2) a))))))))

(define (exec-seq ss a)
  (if (null? ss) #f
      (let ((r (exec (car ss) a))) (if r r (exec-seq (cdr ss) a)))))
(define (exec s a)                     ;; -> #f, or ("ret" value)
  (tick!)
  (let ((op (car s)))
    (cond ((equal? op "set!") (write-var! a (list-ref s 1) (eval-expr (list-ref s 2) a)) #f)
          ((equal? op "if")
           (if (truthy (eval-expr (list-ref s 1) a)) (exec (list-ref s 2) a)
               (if (> (length s) 3) (exec (list-ref s 3) a) #f)))
          ((equal? op "while")
           (let loop ()
             (if (truthy (eval-expr (list-ref s 1) a))
                 (let ((r (exec-seq (list-tail s 2) a))) (if r r (loop)))
                 #f)))
          ((equal? op "begin") (exec-seq (cdr s) a))
          ((equal? op "return") (list "ret" (eval-expr (list-ref s 1) a)))
          ((equal? op "print") (set! *out* (cons (eval-expr (list-ref s 1) a) *out*)) #f)
          ((equal? op "call") (do-call s a) #f)
          ((equal? op "send") (do-send s a #f) #f)
          ((equal? op "reg-set!") (vector-set! *regs* (reg-index (list-ref s 1)) (eval-expr (list-ref s 2) a)) #f)
          ((equal? op "break") (snap! (list-ref s 1)) #f)
          ((equal? op "field-set!")
           (obj-field (eval-expr (list-ref s 1) a) (list-ref s 2) #t (eval-expr (list-ref s 3) a)) #f)
          (else (error (string-append "unknown statement " op))))))

;; ---------------------------------------------------------------- calls
(define (make-closure p a)             ;; a procedure value: code + the AR its free names resolve in
  (let* ((ci (pinfo p)) (parent (pparent p)))
    (if (not (ancestor-or-self? parent (ar-proc a)))
        (error (string-append "procedure " p " is not visible from " (ar-proc a))) #f)
    (list "closure" p (if (equal? parent "%program") 0
                          (follow a (- (plevel (ar-proc a)) (plevel parent)) "static")))))

(define (do-call e a)
  (let* ((target (list-ref e 1)) (args (list-tail e 2)) (caller (ar-proc a)))
    (if (decl-proc caller target)
        ;; calling a procedure-valued variable (a procedure parameter)
        (let ((clo (read-var a target)))
          (if (not (tagged? clo "closure")) (error (string-append target " is not a procedure")) #f)
          (let ((sl (if (equal? (closure-link) "env") (list-ref clo 2) a)))
            (invoke (list-ref clo 1) sl (string-append "closure(" (closure-link) ")") args a)))
        (let* ((ci (pinfo target)) (parent (pparent target)))
          (if (not (ancestor-or-self? parent caller))
              (error (string-append "procedure " target " is not visible from " caller)) #f)
          (if (equal? parent "%program")
              (invoke target 0 "global" args a)        ;; top-level procedure: its free names are globals
              (let ((hops (static-link-hops (plevel caller) (plevel target))))
                (invoke target (follow a hops "static") hops args a)))))))

(define (pass-actuals p params args a)  ;; evaluated in the caller's frame, before the callee's AR exists
  (map (lambda (pa)
         (let* ((x (car pa)) (arg (cdr pa)) (mode (pass-mode p x)))
           (cond ((equal? mode "value") (list (eval-expr arg a) #f))
                 ((equal? mode "reference")
                  (list (cons "ref" (if (string? arg) (addr-of a arg) (list (alloc-temp! (eval-expr arg a)) 0))) #f))
                 ((equal? mode "value-result")
                  (list (eval-expr arg a) (if (string? arg) (addr-of a arg) #f)))
                 ((equal? mode "name") (list (list "name" arg a) #f))
                 (else (error (string-append "unknown parameter mode " mode " for " p "." x))))))
       (zip params args)))
(define (zip xs ys) (if (or (null? xs) (null? ys)) (list) (cons (cons (car xs) (car ys)) (zip (cdr xs) (cdr ys)))))

(define (show v)
  (cond ((tagged? v "name") "<thunk>") ((tagged? v "closure") (string-append "<proc " (list-ref v 1) ">")) (else v)))

(define (invoke p sl how args caller-ar)
  (let* ((i (pinfo p)) (params (hash-ref i "params" (list))))
    (if (not (= (length params) (length args)))
        (error (string-append p ": expected " (num (length params)) " argument(s), got " (num (length args)))) #f)
    (if (>= (length *stack*) *max-depth*) (error "stack overflow (depth limit)") #f)
    (let* ((actuals (pass-actuals p params args caller-ar))
           (id (alloc-ar! p))
           (saved (hash-ref (ar-meta id) "saved" (list))))
      (set! *callno* (+ *callno* 1))
      (stat-inc! "calls")
      (fset-if! id "ret" (string-append (ar-proc caller-ar) "@call" (num *callno*)))
      (fset-if! id "dynamic" caller-ar)
      (fset-if! id "static" sl)
      (for-each (lambda (pv) (fset! id (string-append "p:" (car pv)) (car (cdr pv)) "passing parameters"))
                (zip params actuals))
      (for-each (lambda (r) (fset! id (string-append "s:" r) (vector-ref *regs* (reg-index r)) "saving registers")) saved)
      (set! *stack* (cons id *stack*))
      (stat-max! "max-depth" (length *stack*))
      (set! *trace* (cons (hash "ev" "call" "id" id "proc" p "level" (plevel p) "args" (map (lambda (pv) (show (car (cdr pv)))) (zip params actuals))
                                "static" sl "dynamic" caller-ar "how" how "depth" (length *stack*)) *trace*))
      (let* ((r (exec-seq (hash-ref i "body" (list)) id))
             (rv (if r (car (cdr r)) 0)))
        (fget id "ret" "returning: where to jump back to")
        ;; value-result: copy the final formal values back into the caller's variables
        (for-each (lambda (pv) (if (car (cdr (cdr pv))) (mem-set! (car (cdr (cdr pv))) (fget id (string-append "p:" (car pv)) "copy-out")) #f))
                  (zip params actuals))
        (for-each (lambda (r) (vector-set! *regs* (reg-index r) (fget id (string-append "s:" r) "restoring registers"))) saved)
        (set! *trace* (cons (hash "ev" "return" "id" id "proc" p "value" (show rv) "depth" (length *stack*)) *trace*))
        (set! *stack* (cdr *stack*))
        (hash-remove! *mem* id)
        (hash-remove! *meta* id)
        rv))))

;; ---------------------------------------------------------------- objects (6.3.2-style object records + method vectors)
(define (cinfo c) (let ((i (hash-ref *classes* c #f))) (if i i (error (string-append "no such class: " c)))))
(define (new-object c)
  (let* ((ci (cinfo c)) (fields (hash-ref ci "fields" (list)))
         (id (new-ar! (hash "proc" (string-append "%obj " c) "level" -1 "kind" "object" "saved" (list)
                            "layout" (cons (cons "mv" 0) (push-names (list) "f:" fields 1)))
                      (+ 1 (length fields)))))
    (vector-set! (hash-ref *mem* id #f) 0 c)       ;; slot 0: pointer to the class's method vector
    (stat-inc! "objects")
    (list "obj" id c)))
(define (obj-field o f set? v)
  (if (not (tagged? o "obj")) (error "field access on a non-object") #f)
  (if set? (fset! (cadr o) (string-append "f:" f) v "field store") (fget (cadr o) (string-append "f:" f) "field load")))
(define (method-slot c m)
  (let loop ((vt (hash-ref (cinfo c) "vtable" (list))) (i 0))
    (cond ((null? vt) (error (string-append "class " c " has no method " m)))
          ((equal? (car (car vt)) m) (cons i (cdr (car vt))))
          (else (loop (cdr vt) (+ i 1))))))
(define (do-send e a declared)          ;; e = ("send" obj-expr method arg...)
  (let* ((o (eval-expr (list-ref e 1) a))
         (m (list-ref e 2))
         (runtime-class (if (tagged? o "obj") (mem-ref (list (cadr o) 0)) (error "send to a non-object")))
         (c (if declared (dispatch-class runtime-class declared) runtime-class))
         (slot (method-slot c m)))
    (stat-inc! "sends")
    (set! *trace* (cons (hash "ev" "send" "method" m "object-class" runtime-class "vtable-of" c "slot" (car slot) "impl" (cdr slot)) *trace*))
    ;; the receiver is passed as the first (by-value) actual: ("self-literal" o)
    (invoke-with-self (cdr slot) o (list-tail e 3) a)))
(define (invoke-with-self impl o args a)
  (let ((tmp (alloc-temp! o)))
    (invoke impl 0 "method" (cons (list "%temp-load" tmp) args) a)))

;; ---------------------------------------------------------------- snapshots of the stack
(define (frame-view id)
  (let* ((m (ar-meta id)) (v (hash-ref *mem* id #f)))
    (hash "id" id "proc" (hash-ref m "proc" "?") "level" (hash-ref m "level" 0)
          "fields" (map (lambda (fo) (list (cdr fo) (car fo) (show (vector-ref v (cdr fo))))) (hash-ref m "layout" (list))))))
(define (frames-now) (map frame-view (append *stack* (list 0))))
(define (snap! label) (set! *snaps* (cons (hash "label" label "frames" (frames-now) "event" (length *trace*)) *snaps*)))

;; ---------------------------------------------------------------- run
(define (reset-machine!)
  (set! *mem* (hash)) (set! *meta* (hash)) (set! *stack* (list)) (set! *next-ar* 0)
  (set! *regs* (make-vector 4 0)) (set! *out* (list)) (set! *trace* (list)) (set! *snaps* (list))
  (set! *stats* (hash)) (set! *fuel* 0) (set! *callno* 0)
  ;; AR #0: the program's own storage for globals (static addresses; no links)
  (new-ar! (hash "proc" "%program" "level" 0 "layout" (push-names (list) "l:" *globals* 0) "saved" (list) "kind" "program")
           (length *globals*)))

(define (run!)
  (reset-machine!)
  (let* ((res (try (begin (invoke "main" 0 "global" (list) 0) #f) (catch (e) e)))
         (frames (if res (frames-now) (list))))
    (hash "output" (reverse *out*) "trace" (reverse *trace*) "snaps" (reverse *snaps*) "stats" *stats*
          "error" (if res res #f) "frames" frames)))

;; ---------------------------------------------------------------- protocol
(define *snap-stack* (list))
(define (reply h) (display "R ") (display (json-encode h)) (newline))
(define (field fs i) (if (< i (length fs)) (list-ref fs i) ""))
(define (handle fs)
  (let ((cmd (field fs 0)))
    (cond
      ((equal? cmd "POLICY")
       (let ((r (try (begin (set-code (read-file (field fs 1))) (eval-current) (set! *snap-stack* (list)) (ast:snapshot "base"))
                     (catch (e) (list "error" e)))))
         (if (tagged? r "error") (reply (hash "error" (cadr r))) (reply (hash "ok" #t "snap" r)))))
      ((equal? cmd "LOAD")
       (let ((r (try (begin (load-program! (json-parse (field fs 1))) #t) (catch (e) e))))
         (if (eq? r #t) (reply (hash "ok" #t "procs" (hash-keys *procs*))) (reply (hash "error" r)))))
      ((equal? cmd "RUN") (if *loaded* (reply (run!)) (reply (hash "error" "no program loaded"))))
      ((equal? cmd "MUTATE")
       (let* ((snap (ast:snapshot (string-append "before " (field fs 1))))
              (r (try (mutate:rebind (field fs 1) (field fs 2) (field fs 3)) (catch (e) (list "error" e))))
              (ev (if (eq? r #t) (try (begin (eval-current) #t) (catch (e) #f)) #f)))
         (if (and (eq? r #t) ev)
             (begin (set! *snap-stack* (cons snap *snap-stack*)) (reply (hash "ok" #t "snap" snap "depth" (length *snap-stack*))))
             (begin (try (begin (ast:restore snap) (eval-current)) (catch (e) #f))
                    (reply (hash "ok" #f "rebind" r "eval_ok" ev))))))
      ((equal? cmd "ROLLBACK")
       (if (null? *snap-stack*) (reply (hash "ok" #f "error" "nothing to roll back"))
           (let ((r (try (ast:restore (car *snap-stack*)) (catch (e) #f))))
             (set! *snap-stack* (cdr *snap-stack*))
             (let ((ev (try (begin (eval-current) #t) (catch (e) #f))))
               (reply (hash "ok" (and (eq? r #t) ev) "depth" (length *snap-stack*)))))))
      ((equal? cmd "SOURCE") (reply (hash "source" (current-source :workspace))))
      ((equal? cmd "CALL") (reply (hash "value" (call-policy (field fs 1) (list-tail fs 2)))))
      ((equal? cmd "PING") (reply (hash "pong" #t)))
      (else (reply (hash "error" (string-append "unknown command: " cmd)))))))

(define (arg v) (let ((n (string->number v))) (if n n v)))
(define (call-policy name args)
  (let ((xs (map arg args)))
    (try
      (cond ((equal? name "static-link-hops") (static-link-hops (car xs) (cadr xs)))
            ((equal? name "access-hops") (access-hops (car xs) (cadr xs)))
            ((equal? name "access-chain") (access-chain))
            ((equal? name "closure-link") (closure-link))
            ((equal? name "pass-mode") (pass-mode (car xs) (cadr xs)))
            ((equal? name "frame-areas") (frame-areas (car xs)))
            ((equal? name "callee-saves") (callee-saves (car xs)))
            ((equal? name "dispatch-class") (dispatch-class (car xs) (cadr xs)))
            (else (list "error" (string-append "unknown policy " name))))
      (catch (e) (list "error" e)))))

(define (serve)
  (let ((line (read-line)))
    (if (or (eof-object? line) (equal? line "QUIT")) #t
        (begin (handle (string-split line "\t")) (serve)))))

(reply (hash "ready" #t))
(serve)
