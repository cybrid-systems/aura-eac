;; aura-eac chapter 7 engine: a tiny source language -> ILOC code generator + ILOC machine + reference interpreter.
;;
;; Every "code shape" decision (which operand to evaluate first, how to encode a boolean, how to lay out and
;; address an array, how to implement a case statement) is asked of a define in the Aura WORKSPACE
;; (ch07/policy.aura). This file is the fixed part: the generator's skeleton, a virtual-register allocator
;; that hands out registers in stack order (so the number of distinct registers in the emitted code is the
;; peak register pressure), an ILOC interpreter that executes the emitted code against a byte-addressed
;; memory, and a direct interpreter of the source program that defines what the code must compute.
;;
;; Workspace rules (Aura issues): policies are pure functions of their arguments (aura#4587), no recursive
;; defines in the workspace (aura#4583), no filter/map in the workspace (aura#4584).
;;
;; Source language (JSON form of the host's s-expressions):
;;   (program (vars x y ...) (arrays (A (lo hi) (lo hi) ...) ...) (body stmt ...))
;;   stmt: (set! x e) (aset! A i ... e) (print e) (if c s [s]) (while c s ...) (begin s ...)
;;         (case e (key s ...) ... (else s ...))
;;   expr: n | x | (+ - * / % a b) | (< <= > >= = != a b) | (and a b) (or a b) (not a) | (inc! x) | (aref A i ...)
;;   and/or short-circuit and operands evaluate left to right (the language definition the code must honour).
;;
;; Protocol (same framing as engine/engine.aura): POLICY path | LOAD json | RUN | ADDR A i ... |
;;   MUTATE name body reason | ROLLBACK | SOURCE | CALL name arg ... | PING | QUIT

(define *vars* (list))
(define *arrays* (list))
(define *body* (list))
(define *loaded* #f)

;; WORKAROUND cybrid-systems/aura#4588 / #4586: an error raised inside a let initializer (or a map/for-each
;; callback) can be swallowed and the computation keeps going. Every error goes through `fail`, which records it
;; in *err* first; emission and machine writes stop once *err* is set and the run reports *err*.
(define *err* #f)
(define (fail msg) (if *err* #f (set! *err* msg)) (error msg))
(define (live?) (not *err*))
(define *fuel* 0)
(define (tick!)
  (if *err* (error *err*) #f)
  (set! *fuel* (+ *fuel* 1))
  (if (> *fuel* 400000) (fail "fuel exhausted (infinite loop?)") #f))
(define (tagged? v tag) (and (pair? v) (equal? (car v) tag)))
(define (num n) (number->string n))
(define (b2i b) (if b 1 0))
(define (iota-list n) (let loop ((i (- n 1)) (acc (list))) (if (< i 0) acc (loop (- i 1) (cons i acc)))))
(define (take xs n) (if (or (<= n 0) (null? xs)) (list) (cons (car xs) (take (cdr xs) (- n 1)))))
(define (list-min xs) (let loop ((m (car xs)) (r (cdr xs))) (if (null? r) m (loop (if (< (car r) m) (car r) m) (cdr r)))))
(define (list-max xs) (let loop ((m (car xs)) (r (cdr xs))) (if (null? r) m (loop (if (> (car r) m) (car r) m) (cdr r)))))
(define (bigger a b) (if (> a b) a b))
(define (insert-by-car p xs) (cond ((null? xs) (list p)) ((< (car p) (car (car xs))) (cons p xs)) (else (cons (car xs) (insert-by-car p (cdr xs))))))
(define (sort-by-car xs) (let loop ((xs xs) (acc (list))) (if (null? xs) acc (loop (cdr xs) (insert-by-car (car xs) acc)))))
(define (bool? v) (or (eq? v #t) (eq? v #f)))
(define (one-of xs) (lambda (v) (if (member v xs) #t #f)))

;; ---------------------------------------------------------------- policy calls (fenced)
(define (pol name v ok?)
  (if (and (not (tagged? v "%policy-error")) (ok? v)) v
      (fail (string-append "policy " name " " (if (tagged? v "%policy-error") (string-append "raised: " (cadr v)) "returned an invalid value")))))
(define (perr e) (list "%policy-error" e))
(define (P-su-need l r) (pol "su-need" (try (su-need l r) (catch (e) (perr e))) number?))
(define (P-eval-first op l r) (pol "eval-first" (try (eval-first op l r) (catch (e) (perr e))) (one-of (list "left" "right"))))
(define (P-may-reorder? a b) (pol "may-reorder?" (try (may-reorder? a b) (catch (e) (perr e))) bool?))
(define (P-bool-encoding c) (pol "bool-encoding" (try (bool-encoding c) (catch (e) (perr e))) (one-of (list "numerical" "positional"))))
(define (P-short-circuit? op fx tr) (pol "short-circuit?" (try (short-circuit? op fx tr) (catch (e) (perr e))) bool?))
(define (P-bool-op-code op) (pol "bool-op-code" (try (bool-op-code op) (catch (e) (perr e))) (one-of (list "and" "or" "add" "mult" "sub"))))
(define (P-array-layout a) (pol "array-layout" (try (array-layout a) (catch (e) (perr e))) (one-of (list "row" "column" "indirect"))))
(define (P-extent lo hi) (pol "extent" (try (extent lo hi) (catch (e) (perr e))) number?))
(define (P-index-origin lo) (pol "index-origin" (try (index-origin lo) (catch (e) (perr e))) number?))
(define (P-bounds-check? a) (pol "bounds-check?" (try (bounds-check? a) (catch (e) (perr e))) bool?))
(define (P-dope-vector? a) (pol "dope-vector?" (try (dope-vector? a) (catch (e) (perr e))) bool?))
(define (P-case-strategy n lo hi) (pol "case-strategy" (try (case-strategy n lo hi) (catch (e) (perr e))) (one-of (list "linear" "binary" "jump"))))
(define (P-jump-range-check?) (pol "jump-range-check?" (try (jump-range-check?) (catch (e) (perr e))) bool?))
(define (P-sort-case-keys?) (pol "sort-case-keys?" (try (sort-case-keys?) (catch (e) (perr e))) bool?))

;; ---------------------------------------------------------------- loading
(define (prog-section prog key)
  (let loop ((xs (cdr prog)))
    (cond ((null? xs) (list)) ((equal? (car (car xs)) key) (cdr (car xs))) (else (loop (cdr xs))))))
(define (load-program! prog)
  (set! *vars* (prog-section prog "vars"))
  (set! *arrays* (prog-section prog "arrays"))
  (set! *body* (prog-section prog "body"))
  (set! *loaded* #t))
(define (var-off x)
  (let loop ((vs *vars*) (i 0))
    (cond ((null? vs) (fail (string-append "undeclared variable " x)))
          ((equal? (car vs) x) (* 4 i))
          (else (loop (cdr vs) (+ i 1))))))

;; ---------------------------------------------------------------- expression facts
(define (rel? op) (if (member op (list "<" "<=" ">" ">=" "=" "!=")) #t #f))
(define (boolish? op) (or (rel? op) (equal? op "and") (equal? op "or") (equal? op "not")))
(define (rel-opcode op)
  (cond ((equal? op "<") "cmp_LT") ((equal? op "<=") "cmp_LE") ((equal? op ">") "cmp_GT")
        ((equal? op ">=") "cmp_GE") ((equal? op "=") "cmp_EQ") (else "cmp_NE")))
(define (arith-opcode op)
  (cond ((equal? op "+") "add") ((equal? op "-") "sub") ((equal? op "*") "mult") ((equal? op "/") "div")
        ((equal? op "%") "mod") (else (fail (string-append "unknown operator " op)))))
(define (has-effects? e)
  (cond ((not (pair? e)) #f) ((equal? (car e) "inc!") #t) (else (any? has-effects? (cdr e)))))
(define (may-trap? e)
  (cond ((not (pair? e)) #f) ((member (car e) (list "/" "%" "aref")) #t) (else (any? may-trap? (cdr e)))))
(define (any? f xs) (cond ((null? xs) #f) ((f (car xs)) #t) (else (any? f (cdr xs)))))
(define (max-need es) (let loop ((es es) (m 0)) (if (null? es) m (loop (cdr es) (bigger m (need (car es)))))))
(define (need e)                        ;; register need (labels via the su-need policy)
  (cond ((number? e) 1) ((string? e) 1)
        (else (let ((op (car e)))
                (cond ((equal? op "inc!") 1)
                      ((equal? op "not") (need (cadr e)))
                      ((or (equal? op "aref") (equal? op "%addr")) (+ 1 (max-need (list-tail e 2))))
                      (else (P-su-need (need (cadr e)) (need (list-ref e 2)))))))))

;; ---------------------------------------------------------------- code generation state
(define *code* (list))
(define *top* 0)
(define *maxreg* 0)
(define *nlabel* 0)
(define *heap* 0)
(define *init* (list))
(define *layouts* (hash))
(define *uses-bounds* #f)
(define *cstats* (hash))
(define *cases* (list))
(define (emit! ins) (if (live?) (set! *code* (cons ins *code*)) #f))
(define (alloc!)
  (let ((r (string-append "r" (num *top*))))
    (set! *top* (+ *top* 1))
    (if (> *top* *maxreg*) (set! *maxreg* *top*) #f)
    r))
(define (free! n) (set! *top* (- *top* n)))
(define (new-label!) (set! *nlabel* (+ *nlabel* 1)) (string-append "L" (num *nlabel*)))
(define (label! l) (emit! (list "label" l)))
(define (cstat-add! k n) (hash-set! *cstats* k (+ n (hash-ref *cstats* k 0))))

;; ---------------------------------------------------------------- 7.3 expressions
(define (gen e)                         ;; -> register holding e; leaves exactly one more register in use
  (tick!)
  (cond ((number? e) (let ((r (alloc!))) (emit! (list "loadI" e r)) r))
        ((string? e) (let ((r (alloc!))) (emit! (list "loadAI" "rarp" (var-off e) r)) r))
        (else
         (let ((op (car e)))
           (cond ((equal? op "inc!")
                  (let ((r (alloc!)) (o (var-off (cadr e))))
                    (emit! (list "loadAI" "rarp" o r)) (emit! (list "addI" r 1 r)) (emit! (list "storeAI" r "rarp" o)) r))
                 ((equal? op "aref") (let ((r (gen-address (cadr e) (list-tail e 2)))) (emit! (list "load" r r)) r))
                 ((equal? op "%addr") (gen-address (cadr e) (list-tail e 2)))
                 ((boolish? op) (gen-bool-value e))
                 (else (gen-binary op (arith-opcode op) (cadr e) (list-ref e 2))))))))

(define (gen-binary op opc a b)
  (let* ((ln (need a)) (rn (need b))
         (right-first (and (equal? (P-eval-first op ln rn) "right")
                           (P-may-reorder? (has-effects? a) (has-effects? b)))))
    (if right-first
        (let* ((rb (gen b)) (ra (gen a))) (emit! (list opc ra rb rb)) (free! 1) rb)
        (let* ((ra (gen a)) (rb (gen b))) (emit! (list opc ra rb ra)) (free! 1) ra))))

;; ---------------------------------------------------------------- 7.4 booleans
(define (gen-bool-value e)              ;; value context: the 0/1 result is needed in a register
  (if (equal? (P-bool-encoding "value") "positional")
      (let ((lt (new-label!)) (lf (new-label!)) (le (new-label!)))
        (gen-cond e lt lf)
        (let ((r (alloc!)))
          (label! lt) (emit! (list "loadI" 1 r)) (emit! (list "jumpI" le))
          (label! lf) (emit! (list "loadI" 0 r)) (label! le) r))
      (gen-numeric e)))

(define (gen-numeric e)
  (let ((op (car e)))
    (cond ((rel? op) (gen-binary op (rel-opcode op) (cadr e) (list-ref e 2)))
          ((equal? op "not") (let ((r (gen (cadr e)))) (emit! (list "xorI" r 1 r)) r))
          (else
           (let ((a (cadr e)) (b (list-ref e 2)))
             (if (P-short-circuit? op (has-effects? b) (may-trap? b))
                 (let ((r (gen a)) (lrhs (new-label!)) (lend (new-label!)))
                   (emit! (if (equal? op "and") (list "cbr" r lrhs lend) (list "cbr" r lend lrhs)))
                   (label! lrhs)
                   (let ((rb (gen b))) (emit! (list "i2i" rb r)) (free! 1))
                   (label! lend) r)
                 (gen-binary op (P-bool-op-code op) a b)))))))

(define (gen-cond e lt lf)              ;; branch context: jump to lt if e is true, else to lf
  (if (and (pair? e) (boolish? (car e)) (equal? (P-bool-encoding "branch") "positional"))
      (let ((op (car e)))
        (cond ((equal? op "not") (gen-cond (cadr e) lf lt))
              ((rel? op)
               (let ((r (gen-binary op (rel-opcode op) (cadr e) (list-ref e 2)))) (emit! (list "cbr" r lt lf)) (free! 1)))
              (else
               (let ((a (cadr e)) (b (list-ref e 2)))
                 (if (P-short-circuit? op (has-effects? b) (may-trap? b))
                     (let ((mid (new-label!)))
                       (if (equal? op "and") (gen-cond a mid lf) (gen-cond a lt mid))
                       (label! mid)
                       (gen-cond b lt lf))
                     (let ((r (gen-binary op (P-bool-op-code op) a b))) (emit! (list "cbr" r lt lf)) (free! 1)))))))
      (let ((r (gen e))) (emit! (list "cbr" r lt lf)) (free! 1))))

;; ---------------------------------------------------------------- 7.5 arrays
;; Each array has a dope vector (4 words per dimension: lo, hi, origin, extent) followed by its storage.
(define (arr-info a) (let ((i (hash-ref *layouts* a #f))) (if i i (fail (string-append "unknown array " a)))))
(define (dope-off info k field) (+ (hash-ref info "dope" 0) (* 16 k) (* 4 field)))
(define (alloc-words! n) (let ((a *heap*)) (set! *heap* (+ *heap* (* 4 n))) a))
(define (init! addr v) (set! *init* (cons (cons addr v) *init*)))
(define (true-extent d) (+ (- (cadr d) (car d)) 1))
(define (cells dims) (let loop ((ds dims) (n 1)) (if (null? ds) n (loop (cdr ds) (* n (true-extent (car ds)))))))
(define (alloc-indirect! dims)          ;; vector of pointers to sub-vectors, down to the element vectors
  (let ((v (alloc-words! (true-extent (car dims)))))
    (if (pair? (cdr dims))
        (let loop ((i 0))
          (if (< i (true-extent (car dims)))
              (let ((sub (alloc-indirect! (cdr dims)))) (init! (+ v (* 4 i)) sub) (loop (+ i 1)))
              #f))
        #f)
    v))
(define (layout-arrays!)
  (for-each
    (lambda (ad)
      (let* ((name (car ad)) (dims (cdr ad)) (lay (P-array-layout name)) (dope (alloc-words! (* 4 (length dims)))))
        (let loop ((k 0) (ds dims))
          (if (pair? ds)
              (let ((d (car ds)) (at (+ dope (* 16 k))))
                (init! at (car d)) (init! (+ at 4) (cadr d))
                (init! (+ at 8) (P-index-origin (car d))) (init! (+ at 12) (P-extent (car d) (cadr d)))
                (loop (+ k 1) (cdr ds)))
              #f))
        (let ((base (if (equal? lay "indirect") (alloc-indirect! dims) (alloc-words! (cells dims)))))
          (hash-set! *layouts* name (hash "dims" dims "layout" lay "dope" dope "base" base)))))
    *arrays*))

(define (gen-address a idxs)            ;; -> register holding the byte address of a[idxs]
  (let* ((info (arr-info a)) (dims (hash-ref info "dims" (list))) (lay (hash-ref info "layout" "row"))
         (dope (P-dope-vector? a)) (chk (P-bounds-check? a)))
    (if (not (= (length dims) (length idxs))) (fail (string-append a ": wrong number of subscripts")) #f)
    (if (equal? lay "indirect") (gen-indirect info dims idxs dope chk) (gen-linear info dims idxs lay dope chk))))
(define (gen-bounds r info k d dope)
  (set! *uses-bounds* #t)
  (let ((t (alloc!)) (ok1 (new-label!)) (ok2 (new-label!)))
    (if dope (emit! (list "loadAI" "rarp" (dope-off info k 0) t)) (emit! (list "loadI" (car d) t)))
    (emit! (list "cmp_LT" r t t)) (emit! (list "cbr" t "Lbounds" ok1)) (label! ok1)
    (if dope (emit! (list "loadAI" "rarp" (dope-off info k 1) t)) (emit! (list "loadI" (cadr d) t)))
    (emit! (list "cmp_GT" r t t)) (emit! (list "cbr" t "Lbounds" ok2)) (label! ok2)
    (free! 1)))
(define (gen-index info k e dope chk)   ;; -> register holding (e - origin_k), range-checked first
  (let ((r (gen e)) (d (list-ref (hash-ref info "dims" (list)) k)))
    (if chk (gen-bounds r info k d dope) #f)
    (if dope
        (let ((t (alloc!))) (emit! (list "loadAI" "rarp" (dope-off info k 2) t)) (emit! (list "sub" r t r)) (free! 1))
        (emit! (list "subI" r (P-index-origin (car d)) r)))
    r))
(define (gen-scale r info k d dope)
  (if dope
      (let ((t (alloc!))) (emit! (list "loadAI" "rarp" (dope-off info k 3) t)) (emit! (list "mult" r t r)) (free! 1))
      (emit! (list "multI" r (P-extent (car d) (cadr d)) r))))
(define (gen-linear info dims idxs lay dope chk)
  (let* ((ks (iota-list (length dims))) (order (if (equal? lay "column") (reverse ks) ks))
         (r (gen-index info (car order) (list-ref idxs (car order)) dope chk)))
    (for-each (lambda (k)
                (gen-scale r info k (list-ref dims k) dope)
                (let ((t (gen-index info k (list-ref idxs k) dope chk)))
                  (emit! (list "add" r t r)) (free! 1)))
              (cdr order))
    (emit! (list "multI" r 4 r))
    (emit! (list "addI" r (hash-ref info "base" 0) r))
    r))
(define (gen-indirect info dims idxs dope chk)
  (let ((r (gen-index info 0 (car idxs) dope chk)))
    (emit! (list "multI" r 4 r))
    (emit! (list "addI" r (hash-ref info "base" 0) r))
    (for-each (lambda (k)
                (emit! (list "load" r r))
                (let ((t (gen-index info k (list-ref idxs k) dope chk)))
                  (emit! (list "multI" t 4 t)) (emit! (list "add" r t r)) (free! 1)))
              (cdr (iota-list (length dims))))
    r))

;; ---------------------------------------------------------------- 7.8.3 case
(define (case-arms s) (let loop ((xs (list-tail s 2)) (acc (list)))
  (cond ((null? xs) (reverse acc)) ((number? (car (car xs))) (loop (cdr xs) (cons (car xs) acc))) (else (loop (cdr xs) acc)))))
(define (case-default s) (let loop ((xs (list-tail s 2)))
  (cond ((null? xs) (list)) ((equal? (car (car xs)) "else") (cdr (car xs))) (else (loop (cdr xs))))))
(define (gen-case s)
  (let* ((arms (case-arms s)) (dflt (case-default s))
         (r (gen (cadr s))) (lend (new-label!)) (ldef (new-label!))
         (labeled (map (lambda (arm) (cons (car arm) (new-label!))) arms))
         (keys (map car arms)) (n (length keys)) (lo (list-min keys)) (hi (list-max keys))
         (strat (P-case-strategy n lo hi)))
    (if (live?) (set! *cases* (cons (hash "strategy" strat "arms" n "lo" lo "hi" hi) *cases*)) #f)
    (cond ((equal? strat "linear") (gen-case-linear r labeled ldef))
          ((equal? strat "binary") (gen-case-binary r (if (P-sort-case-keys?) (sort-by-car labeled) labeled) ldef))
          (else (gen-case-jump r labeled lo hi ldef)))
    (free! 1)
    (let loop ((as arms) (ls labeled))
      (if (pair? as)
          (begin (label! (cdr (car ls))) (for-each gen-stmt (cdr (car as))) (emit! (list "jumpI" lend))
                 (loop (cdr as) (cdr ls)))
          #f))
    (label! ldef) (for-each gen-stmt dflt) (label! lend)))
(define (gen-case-linear r labeled ldef)
  (for-each (lambda (kl)
              (let ((t (alloc!)) (nx (new-label!)))
                (emit! (list "loadI" (car kl) t)) (emit! (list "cmp_EQ" r t t)) (emit! (list "cbr" t (cdr kl) nx))
                (free! 1) (label! nx)))
            labeled)
  (emit! (list "jumpI" ldef)))
(define (gen-case-binary r v ldef)
  (let bin ((lo 0) (hi (- (length v) 1)))
    (if (> lo hi) (emit! (list "jumpI" ldef))
        (let* ((mid (quotient (+ lo hi) 2)) (kl (list-ref v mid)) (t (alloc!))
               (ne (new-label!)) (left (new-label!)) (right (new-label!)))
          (emit! (list "loadI" (car kl) t)) (emit! (list "cmp_EQ" r t t)) (emit! (list "cbr" t (cdr kl) ne)) (label! ne)
          (emit! (list "loadI" (car kl) t)) (emit! (list "cmp_LT" r t t)) (emit! (list "cbr" t left right))
          (free! 1)
          (label! left) (bin lo (- mid 1))
          (label! right) (bin (+ mid 1) hi)))))
(define (gen-case-jump r labeled lo hi ldef)
  (let* ((size (+ (- hi lo) 1)) (tbl (alloc-words! size)))
    (let loop ((i 0))
      (if (< i size)
          (let ((e (assoc (+ lo i) labeled))) (init! (+ tbl (* 4 i)) (if e (cdr e) ldef)) (loop (+ i 1)))
          #f))
    (cstat-add! "table-words" size)
    (if (P-jump-range-check?)
        (let ((t (alloc!)) (ok1 (new-label!)) (ok2 (new-label!)))
          (emit! (list "loadI" lo t)) (emit! (list "cmp_LT" r t t)) (emit! (list "cbr" t ldef ok1)) (label! ok1)
          (emit! (list "loadI" hi t)) (emit! (list "cmp_GT" r t t)) (emit! (list "cbr" t ldef ok2)) (label! ok2)
          (free! 1))
        #f)
    (emit! (list "subI" r lo r)) (emit! (list "multI" r 4 r)) (emit! (list "addI" r tbl r))
    (emit! (list "load" r r)) (emit! (list "jump" r))))

;; ---------------------------------------------------------------- statements
(define (gen-stmt s)
  (tick!)
  (let ((op (car s)))
    (cond ((equal? op "set!") (let ((r (gen (list-ref s 2)))) (emit! (list "storeAI" r "rarp" (var-off (cadr s)))) (free! 1)))
          ((equal? op "aset!")
           (let* ((n (length s)) (ra (gen-address (cadr s) (take (list-tail s 2) (- n 3)))) (rv (gen (list-ref s (- n 1)))))
             (emit! (list "store" rv ra)) (free! 2)))
          ((equal? op "print") (let ((r (gen (cadr s)))) (emit! (list "write" r)) (free! 1)))
          ((equal? op "begin") (for-each gen-stmt (cdr s)))
          ((equal? op "if")
           (let ((lt (new-label!)) (lf (new-label!)) (le (new-label!)))
             (gen-cond (cadr s) lt lf)
             (label! lt) (gen-stmt (list-ref s 2)) (emit! (list "jumpI" le))
             (label! lf) (if (> (length s) 3) (gen-stmt (list-ref s 3)) #f)
             (label! le)))
          ((equal? op "while")
           (let ((top (new-label!)) (lb (new-label!)) (le (new-label!)))
             (label! top) (gen-cond (cadr s) lb le)
             (label! lb) (for-each gen-stmt (list-tail s 2)) (emit! (list "jumpI" top))
             (label! le)))
          ((equal? op "case") (gen-case s))
          (else (fail (string-append "unknown statement " op))))
    (if (and (live?) (not (= *top* 0))) (fail (string-append "internal: register stack not empty after " op)) #f)))

(define (compile! body)
  (set! *code* (list)) (set! *top* 0) (set! *maxreg* 0) (set! *nlabel* 0) (set! *init* (list))
  (set! *layouts* (hash)) (set! *uses-bounds* #f) (set! *cstats* (hash)) (set! *cases* (list))
  (set! *heap* (bigger 256 (* 4 (length *vars*))))
  (layout-arrays!)
  (for-each gen-stmt body)
  (emit! (list "halt"))
  (if *uses-bounds* (begin (label! "Lbounds") (emit! (list "trap" "array index out of bounds"))) #f)
  (reverse *code*))

;; ---------------------------------------------------------------- the ILOC machine
(define *regs* (hash))
(define *mem* (hash))
(define *labels* (hash))
(define *vstats* (hash))
(define *out* (list))
(define (vstat! k) (hash-set! *vstats* k (+ 1 (hash-ref *vstats* k 0))))
(define (rget r) (hash-ref *regs* r 0))
(define (rset! r v) (if (live?) (hash-set! *regs* r v) #f))
(define (addr? a) (if (number? a) a (fail "memory access through a non-address")))
(define (mload a) (hash-ref *mem* (addr? a) 0))
(define (mstore! a v) (if (live?) (hash-set! *mem* (addr? a) v) #f))
(define (alu op x y)
  (if (not (and (number? x) (number? y))) (fail (string-append op ": operand is not a number")) #f)
  (cond ((equal? op "add") (+ x y)) ((equal? op "sub") (- x y)) ((equal? op "mult") (* x y))
        ((equal? op "div") (if (= y 0) (fail "division by zero") (quotient x y)))
        ((equal? op "mod") (if (= y 0) (fail "division by zero") (remainder x y)))
        ((equal? op "and") (b2i (and (not (= x 0)) (not (= y 0)))))
        ((equal? op "or") (b2i (or (not (= x 0)) (not (= y 0)))))
        ((equal? op "xor") (if (= y 1) (if (= (remainder x 2) 0) (+ x 1) (- x 1)) (fail "xorI: only xorI r, 1 is supported")))
        ((equal? op "cmp_LT") (b2i (< x y))) ((equal? op "cmp_LE") (b2i (<= x y)))
        ((equal? op "cmp_GT") (b2i (> x y))) ((equal? op "cmp_GE") (b2i (>= x y)))
        ((equal? op "cmp_EQ") (b2i (= x y))) ((equal? op "cmp_NE") (b2i (not (= x y))))
        (else (fail (string-append "unknown opcode " op)))))
(define *binops* (list "add" "sub" "mult" "div" "mod" "and" "or" "cmp_LT" "cmp_LE" "cmp_GT" "cmp_GE" "cmp_EQ" "cmp_NE"))
(define (imm-base op)
  (cond ((equal? op "addI") "add") ((equal? op "subI") "sub") ((equal? op "multI") "mult") ((equal? op "xorI") "xor") (else #f)))
(define (target l) (let ((pc (hash-ref *labels* l #f))) (if pc pc (fail (string-append "jump to unknown label " l)))))
(define (exec-ins ins pc)               ;; -> next pc, or -1 to halt
  (let ((op (car ins)))
    (if (equal? op "label") (+ pc 1)
        (begin
          (vstat! "ops")
          (cond ((equal? op "loadI") (rset! (list-ref ins 2) (cadr ins)) (+ pc 1))
                ((equal? op "loadAI") (vstat! "loads") (rset! (list-ref ins 3) (mload (+ (rget (cadr ins)) (list-ref ins 2)))) (+ pc 1))
                ((equal? op "storeAI") (vstat! "stores") (mstore! (+ (rget (list-ref ins 2)) (list-ref ins 3)) (rget (cadr ins))) (+ pc 1))
                ((equal? op "load") (vstat! "loads") (rset! (list-ref ins 2) (mload (rget (cadr ins)))) (+ pc 1))
                ((equal? op "store") (vstat! "stores") (mstore! (rget (list-ref ins 2)) (rget (cadr ins))) (+ pc 1))
                ((member op *binops*)
                 (if (equal? op "mult") (vstat! "mults") #f)
                 (if (equal? (substring op 0 3) "cmp") (vstat! "cmps") #f)
                 (rset! (list-ref ins 3) (alu op (rget (cadr ins)) (rget (list-ref ins 2)))) (+ pc 1))
                ((imm-base op)
                 (if (equal? op "multI") (vstat! "mults") #f)
                 (rset! (list-ref ins 3) (alu (imm-base op) (rget (cadr ins)) (list-ref ins 2))) (+ pc 1))
                ((equal? op "i2i") (rset! (list-ref ins 2) (rget (cadr ins))) (+ pc 1))
                ((equal? op "cbr") (vstat! "branches")
                 (let ((v (rget (cadr ins))))
                   (if (and (number? v) (= v 0)) (target (list-ref ins 3)) (target (list-ref ins 2)))))
                ((equal? op "jumpI") (vstat! "jumps") (target (cadr ins)))
                ((equal? op "jump") (vstat! "jumps")
                 (let ((l (rget (cadr ins))))
                   (if (and (string? l) (hash-ref *labels* l #f)) (target l)
                       (fail (string-append "jump through a table entry that is not a label: " (if (number? l) (num l) "?"))))))
                ((equal? op "write") (if (live?) (set! *out* (cons (rget (cadr ins)) *out*)) #f) (+ pc 1))
                ((equal? op "trap") (fail (cadr ins)))
                ((equal? op "halt") -1)
                (else (fail (string-append "unknown opcode " op))))))))
(define (run-vm code init)
  (let* ((n (length code)) (prog (make-vector n 0)))
    (set! *regs* (hash)) (set! *mem* (hash)) (set! *labels* (hash)) (set! *vstats* (hash)) (set! *out* (list))
    (let loop ((cs code) (i 0))
      (if (pair? cs)
          (begin (vector-set! prog i (car cs))
                 (if (equal? (car (car cs)) "label") (hash-set! *labels* (cadr (car cs)) i) #f)
                 (loop (cdr cs) (+ i 1)))
          #f))
    (for-each (lambda (av) (hash-set! *mem* (car av) (cdr av))) init)
    (hash-set! *regs* "rarp" 0)
    (let step ((pc 0))
      (tick!)
      (if (or (< pc 0) (>= pc n)) #t (step (exec-ins (vector-ref prog pc) pc))))))

;; ---------------------------------------------------------------- reference interpreter (the language definition)
(define *env* (hash))
(define *arr* (hash))
(define *rout* (list))
(define (truth v) (not (equal? v 0)))
(define (arr-dims a)
  (let ((e (assoc a *arrays*))) (if e (cdr e) (fail (string-append "unknown array " a)))))
(define (ref-key a idx-exprs)
  (let loop ((es idx-exprs) (ds (arr-dims a)) (key a))
    (cond ((and (null? es) (null? ds)) key)
          ((or (null? es) (null? ds)) (fail (string-append a ": wrong number of subscripts")))
          (else (let ((v (ref-eval (car es))))
                  (if (or (< v (car (car ds))) (> v (cadr (car ds)))) (fail "array index out of bounds") #f)
                  (loop (cdr es) (cdr ds) (string-append key "," (num v))))))))
(define (ref-eval e)
  (tick!)
  (cond ((number? e) e)
        ((string? e) (var-off e) (hash-ref *env* e 0))
        (else
         (let ((op (car e)))
           (cond ((equal? op "inc!") (let ((v (+ 1 (hash-ref *env* (cadr e) 0)))) (if (live?) (hash-set! *env* (cadr e) v) #f) v))
                 ((equal? op "aref") (hash-ref *arr* (ref-key (cadr e) (list-tail e 2)) 0))
                 ((equal? op "and") (if (truth (ref-eval (cadr e))) (b2i (truth (ref-eval (list-ref e 2)))) 0))
                 ((equal? op "or") (if (truth (ref-eval (cadr e))) 1 (b2i (truth (ref-eval (list-ref e 2))))))
                 ((equal? op "not") (b2i (not (truth (ref-eval (cadr e))))))
                 (else
                  (let* ((x (ref-eval (cadr e))) (y (ref-eval (list-ref e 2))))
                    (alu (if (rel? op) (rel-opcode op) (arith-opcode op)) x y))))))))
(define (ref-exec s)
  (tick!)
  (let ((op (car s)))
    (cond ((equal? op "set!") (var-off (cadr s)) (let ((v (ref-eval (list-ref s 2)))) (if (live?) (hash-set! *env* (cadr s) v) #f)))
          ((equal? op "aset!")
           (let* ((n (length s)) (k (ref-key (cadr s) (take (list-tail s 2) (- n 3)))) (v (ref-eval (list-ref s (- n 1)))))
             (if (live?) (hash-set! *arr* k v) #f)))
          ((equal? op "print") (let ((v (ref-eval (cadr s)))) (if (live?) (set! *rout* (cons v *rout*)) #f)))
          ((equal? op "begin") (for-each ref-exec (cdr s)))
          ((equal? op "if") (if (truth (ref-eval (cadr s))) (ref-exec (list-ref s 2)) (if (> (length s) 3) (ref-exec (list-ref s 3)) #f)))
          ((equal? op "while") (let loop () (if (truth (ref-eval (cadr s))) (begin (for-each ref-exec (list-tail s 2)) (loop)) #f)))
          ((equal? op "case")
           (let* ((v (ref-eval (cadr s))) (arm (assoc v (case-arms s))))
             (for-each ref-exec (if arm (cdr arm) (case-default s)))))
          (else (fail (string-append "unknown statement " op))))))

;; ---------------------------------------------------------------- run
(define (run!)
  ;; 1. what the program means
  (set! *err* #f) (set! *fuel* 0) (set! *env* (hash)) (set! *arr* (hash)) (set! *rout* (list))
  (let* ((rres (try (begin (for-each ref-exec *body*) #f) (catch (e) e)))
         (rerr (if *err* *err* rres))
         (rout (reverse *rout*)))
    ;; 2. compile with the current workspace policies
    (set! *err* #f) (set! *fuel* 0)
    (let* ((cres (try (compile! *body*) (catch (e) (list "%error" e))))
           (cerr (if *err* *err* (if (tagged? cres "%error") (cadr cres) #f))))
      (if cerr
          (hash "error" (string-append "codegen: " cerr) "reference" rout "ref_error" rerr "output" (list) "code" (list))
          (let ((code cres) (init (reverse *init*)) (regs *maxreg*) (cases (reverse *cases*)) (cst *cstats*))
            ;; 3. execute the emitted ILOC
            (set! *err* #f) (set! *fuel* 0)
            (let* ((vres (try (begin (run-vm code init) #f) (catch (e) e)))
                   (verr (if *err* *err* vres)))
              (hash-set! *vstats* "registers" regs)
              (hash-set! *vstats* "code-size" (count-ops code))
              (hash-set! *vstats* "table-words" (hash-ref cst "table-words" 0))
              (hash "output" (reverse *out*) "error" verr "reference" rout "ref_error" rerr
                    "stats" *vstats* "code" code "cases" cases "symbols" (symbols))))))))
(define (count-ops code) (let loop ((cs code) (n 0)) (if (null? cs) n (loop (cdr cs) (if (equal? (car (car cs)) "label") n (+ n 1))))))
(define (symbols)
  (hash "vars" (map (lambda (v) (list v (var-off v))) *vars*)
        "arrays" (map (lambda (ad) (let ((i (hash-ref *layouts* (car ad) (hash))))
                                     (list (car ad) (hash-ref i "layout" "?") (hash-ref i "base" 0) (hash-ref i "dope" 0))))
                      *arrays*)))
(define (address-of a idx)              ;; byte address the current policies give a[idx] (constant subscripts)
  (set! *err* #f) (set! *fuel* 0)
  (let* ((res (try (let ((code (compile! (list (list "print" (append (list "%addr" a) idx)))))) (run-vm code (reverse *init*)) code)
                   (catch (e) (list "%error" e))))
         (err (if *err* *err* (if (tagged? res "%error") (cadr res) #f))))
    (if err (hash "error" err) (hash "address" (car (reverse *out*)) "code" res "stats" *vstats*))))

;; ---------------------------------------------------------------- protocol
(define *snap-stack* (list))
(define (reply h) (display "R ") (display (json-encode h)) (newline))
(define (field fs i) (if (< i (length fs)) (list-ref fs i) ""))
(define (arg v) (let ((n (string->number v))) (if n n (cond ((equal? v "#t") #t) ((equal? v "#f") #f) (else v)))))
(define (handle fs)
  (let ((cmd (field fs 0)))
    (cond
      ((equal? cmd "POLICY")
       (let ((r (try (begin (set-code (read-file (field fs 1))) (eval-current) (set! *snap-stack* (list)) (ast:snapshot "base"))
                     (catch (e) (list "error" e)))))
         (if (tagged? r "error") (reply (hash "error" (cadr r))) (reply (hash "ok" #t "snap" r)))))
      ((equal? cmd "LOAD")
       (set! *err* #f)
       (let ((r (try (begin (load-program! (json-parse (field fs 1))) #t) (catch (e) e))))
         (if *err* (set! r *err*) #f)
         (set! *err* #f)
         (if (eq? r #t) (reply (hash "ok" #t)) (reply (hash "error" r)))))
      ((equal? cmd "RUN") (if *loaded* (reply (run!)) (reply (hash "error" "no program loaded"))))
      ((equal? cmd "ADDR") (if *loaded* (reply (address-of (field fs 1) (map arg (list-tail fs 2)))) (reply (hash "error" "no program loaded"))))
      ((equal? cmd "MUTATE")
       (let* ((snap (ast:snapshot (string-append "before " (field fs 1))))
              (r (try (mutate:rebind (field fs 1) (field fs 2) (field fs 3)) (catch (e) (list "error" e))))
              (ev (if (eq? r #t) (try (begin (eval-current) #t) (catch (e) #f)) #f)))
         (if (and (eq? r #t) ev)
             (begin (set! *snap-stack* (cons snap *snap-stack*)) (reply (hash "ok" #t "snap" snap "depth" (length *snap-stack*))))
             (begin (try (begin (ast:restore snap) (eval-current)) (catch (e) #f))
                    (reply (hash "ok" #f "rebind" r "eval_ok" ev))))))
      ((equal? cmd "ROLLBACK")
       (if (null? *snap-stack*) (reply (hash "ok" #f "error" "nothing to roll back"))
           (let ((r (try (ast:restore (car *snap-stack*)) (catch (e) #f))))
             (set! *snap-stack* (cdr *snap-stack*))
             (let ((ev (try (begin (eval-current) #t) (catch (e) #f))))
               (reply (hash "ok" (and (eq? r #t) ev) "depth" (length *snap-stack*)))))))
      ((equal? cmd "SOURCE") (reply (hash "source" (current-source :workspace))))
      ((equal? cmd "CALL") (reply (hash "value" (call-policy (field fs 1) (map arg (list-tail fs 2))))))
      ((equal? cmd "PING") (reply (hash "pong" #t)))
      (else (reply (hash "error" (string-append "unknown command: " cmd)))))))

(define (call-policy name xs)
  (try
    (cond ((equal? name "su-need") (su-need (car xs) (cadr xs)))
          ((equal? name "eval-first") (eval-first (car xs) (cadr xs) (list-ref xs 2)))
          ((equal? name "may-reorder?") (may-reorder? (car xs) (cadr xs)))
          ((equal? name "bool-encoding") (bool-encoding (car xs)))
          ((equal? name "short-circuit?") (short-circuit? (car xs) (cadr xs) (list-ref xs 2)))
          ((equal? name "bool-op-code") (bool-op-code (car xs)))
          ((equal? name "array-layout") (array-layout (car xs)))
          ((equal? name "extent") (extent (car xs) (cadr xs)))
          ((equal? name "index-origin") (index-origin (car xs)))
          ((equal? name "bounds-check?") (bounds-check? (car xs)))
          ((equal? name "dope-vector?") (dope-vector? (car xs)))
          ((equal? name "case-strategy") (case-strategy (car xs) (cadr xs) (list-ref xs 2)))
          ((equal? name "jump-range-check?") (jump-range-check?))
          ((equal? name "sort-case-keys?") (sort-case-keys?))
          (else (list "error" (string-append "unknown policy " name))))
    (catch (e) (list "error" e))))

(define (serve)
  (let ((line (read-line)))
    (if (or (eof-object? line) (equal? line "QUIT")) #t
        (begin (handle (string-split line "\t")) (serve)))))

(reply (hash "ready" #t))
(serve)
